# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามเครื่อง
# ไฟล์ .env ถูก gitignore ไว้ ห้าม commit ค่าจริงขึ้น git

# ---- ฐานข้อมูล ----
# KIOSK_DB=D:/smartscreen/Raspberry/server/data/kiosk.db

# ---- เขตเวลา ----
KIOSK_TZ=Asia/Bangkok

# ---- โหมดจำลอง ----
# 1 = เปิดเส้นทาง /api/sim/* สำหรับพัฒนาโดยไม่ต้องมีกล้อง
# ต้องตั้งเป็น 0 เมื่อติดตั้งบนตู้จริง มิฉะนั้นสวมรอยเป็นนักศึกษาคนใดก็ได้
KIOSK_SIM=1

# ---- ผู้ช่วย AI ----
# ไม่ใส่กุญแจ = ปิดผู้ช่วย AI โดยอัตโนมัติ คำถามจากฐานข้อมูลยังทำงานปกติ
# ตารางเรียน ห้องเรียน และกำหนดสอบไม่เคยผ่าน AI ไม่ว่าจะตั้งค่าอย่างไร
#
# เลือกผู้ให้บริการ: gemini | anthropic | auto
# auto = ใช้กุญแจที่ใส่ไว้ ถ้ามีทั้งคู่เลือก gemini ก่อนเพราะมีโควตาให้ใช้ฟรี
KIOSK_AI_PROVIDER=auto

# ใส่กุญแจของรายที่จะใช้ ใส่ตัวเดียวก็พอ
# GEMINI_API_KEY=...          รับที่ aistudio.google.com
# ANTHROPIC_API_KEY=sk-ant-...  รับที่ console.anthropic.com

KIOSK_GEMINI_MODEL=gemini-3.1-flash-lite
KIOSK_AI_MODEL=claude-opus-5

# วินาทีต่อการเรียกหนึ่งครั้ง
KIOSK_AI_TIMEOUT=20
# ลองใหม่กี่ครั้งเมื่อเรียกไม่สำเร็จ เวลารอที่แย่ที่สุด = TIMEOUT x (RETRIES + 1)
# นักศึกษายืนรออยู่ ตอบว่าไม่พบข้อมูลเร็ว ๆ ดีกว่าให้ยืนรอนาน
KIOSK_AI_RETRIES=1
# ฝั่ง anthropic: low | medium | high | xhigh | max
KIOSK_AI_EFFORT=low
# ฝั่ง gemini: เพดานโทเค็นสำหรับคิดก่อนตอบ 0 = ไม่ต้องคิด ตอบเลย
KIOSK_AI_THINKING=0
# เพดานโทเค็นต่อคำตอบ ฝั่ง anthropic นับโทเค็นที่ใช้คิดรวมด้วย
KIOSK_AI_MAX_TOKENS=8000
# ส่งชิ้นเอกสารให้โมเดลอ่านกี่ชิ้น มากไปเปลืองและทำให้โมเดลสับสน
KIOSK_AI_CHUNKS=8

# ---- ความเป็นส่วนตัว ----
# เปลี่ยนเลขนี้เมื่อแก้ข้อความบนหน้าขอความยินยอม
# ความยินยอมฉบับเก่ายังเก็บไว้เป็นหลักฐานว่าผู้ใช้ยินยอมกับข้อความรุ่นใด
KIOSK_CONSENT_VERSION=2569-1
# 1 = โหมดกรอกรหัสนักศึกษาเห็นข้อมูลได้จำกัด (แนะนำ เพราะโหมดนี้ไม่มีการยืนยันตัวตน)
KIOSK_KEYPAD_RESTRICTED=1

# ---- ออกจากระบบอัตโนมัติ (วินาที) ----
KIOSK_SESSION_IDLE=30
KIOSK_SESSION_GRACE=15

# ---- รู้จำใบหน้า ----
KIOSK_FACE_MODEL=buffalo_s
# ระยะโคไซน์ขั้นต่ำที่ถือว่าเป็นคนเดียวกัน ยิ่งสูงยิ่งเข้มงวด (ลดโอกาสจำผิดคน)
KIOSK_FACE_THRESHOLD=0.45
# ช่องว่างขั้นต่ำระหว่างอันดับ 1 กับอันดับ 2 ถ้าใกล้กันเกินไปให้ถือว่าจำไม่ได้
KIOSK_FACE_MARGIN=0.05
# auto | picamera | เลขกล้อง เช่น 0 | off
KIOSK_CAMERA=auto

# ---- แปลงเสียงพูดเป็นข้อความ ----
KIOSK_STT_ENABLED=1
# tiny | base | small | medium — base สมดุลที่สุดบน Raspberry Pi 5
# small แม่นกว่าแต่ช้ากว่าราวสองเท่า
KIOSK_STT_MODEL=base
# ความกว้างของการค้นหาคำตอบ 1 = เร็วสุด · 5 = แม่นสุด
# ถ้าถอดเสียงเพี้ยนบ่อย ลองเพิ่มเป็น 5 หรือเปลี่ยนรุ่นเป็น small
KIOSK_STT_BEAM=3
# 1 = ห้ามดาวน์โหลดโมเดลระหว่างใช้งาน ต้องเตรียมไฟล์ไว้ก่อน (ใช้กับตู้จริง)
KIOSK_STT_OFFLINE_ONLY=0
